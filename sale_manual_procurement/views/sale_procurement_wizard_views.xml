<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_procurement_wizard_form" model="ir.ui.view">
        <field name="name">sale.procurement.wizard.form</field>
        <field name="model">sale.procurement.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Abastecimiento">
                <div class="mb-3 d-flex gap-2">
                    <button name="action_set_all_purchase"
                            type="object"
                            string="Marcar todo: Cotización de Compra"
                            class="btn-secondary btn-sm"
                            icon="fa-shopping-cart"/>
                    <button name="action_set_all_manufacture"
                            type="object"
                            string="Marcar todo: Orden de Fabricación"
                            class="btn-secondary btn-sm"
                            icon="fa-cogs"/>
                </div>
                <p class="text-muted">
                    Los productos marcados como <b>Cotización de Compra</b> se agruparán en una sola solicitud sin proveedor asignado para que lo selecciones dentro de la cotización.
                </p>
                <field name="sale_order_id" invisible="1"/>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="1">
                        <field name="sale_line_id" column_invisible="1"/>
                        <field name="product_id"/>
                        <field name="product_uom_qty"/>
                        <field name="product_uom_id"/>
                        <field name="action_type" widget="radio" options="{'horizontal': true}"/>
                    </list>
                </field>
                <footer>
                    <button name="action_generate_documents"
                            string="Generar Documentos"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cerrar sin generar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
