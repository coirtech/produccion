<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_procurement_wizard_form" model="ir.ui.view">
        <field name="name">sale.procurement.wizard.form</field>
        <field name="model">sale.procurement.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Compra o Fabricación">
                <group>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="global_action" widget="radio" options="{'horizontal': true}"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="sale_line_id" column_invisible="1" force_save="1"/>
                        <field name="product_uom_id" column_invisible="1" force_save="1"/>
                        <field name="product_id" readonly="1" force_save="1"/>
                        <field name="product_uom_qty"/>
                        <field name="action_type"/>
                    </list>
                </field>
                <footer>
                    <button name="action_generate_documents"
                            string="Confirmar"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
