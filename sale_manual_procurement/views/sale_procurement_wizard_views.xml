<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_procurement_wizard_form" model="ir.ui.view">
        <field name="name">sale.procurement.wizard.form</field>
        <field name="model">sale.procurement.wizard</field>
        <field name="arch" type="xml">
            <form string="Seleccionar opción">
                <field name="sale_order_id" invisible="1"/>
                <div class="py-1">
                    <field name="action_type" widget="radio" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_generate_documents"
                            string="Confirmar"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
