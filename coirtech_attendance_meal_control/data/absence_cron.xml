<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_coir_daily_absences" model="ir.cron">
        <field name="name">COIRTECH: faltas a las 09:00 de lunes a viernes</field>
        <field name="model_id" ref="model_coir_attendance_absence"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_absences()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
