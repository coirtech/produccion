<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="work_correction_form" model="ir.ui.view">
        <field name="name">coir.work.correction.form</field>
        <field name="model">coir.work.correction</field>
        <field name="arch" type="xml">
            <form string="Corregir salida de trabajo">
                <group>
                    <field name="outing_id" readonly="1"/>
                    <field name="start"/>
                    <field name="end"/>
                    <field name="reason" placeholder="Indica por qué se corrige este movimiento."/>
                </group>
                <p class="text-muted">Conserva el regreso vacío si no está confirmado. Los movimientos deben quedar dentro de la jornada y no pueden superponerse con la comida u otra salida.</p>
                <footer>
                    <button name="action_apply" type="object" string="Guardar corrección" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
