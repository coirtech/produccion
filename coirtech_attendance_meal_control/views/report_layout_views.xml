<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_layout_list" model="ir.ui.view">
        <field name="name">coir.attendance.report.layout.list</field>
        <field name="model">coir.attendance.report.layout</field>
        <field name="arch" type="xml">
            <list string="Columnas del Reporte de asistencia" delete="0">
                <field name="company_id"/>
                <field name="output_format"/>
                <field name="write_uid" string="Última modificación por"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>
    <record id="report_layout_form" model="ir.ui.view">
        <field name="name">coir.attendance.report.layout.form</field>
        <field name="model">coir.attendance.report.layout</field>
        <field name="arch" type="xml">
            <form string="Personalizar columnas del reporte" delete="0">
                <header>
                    <button name="action_reset_defaults" type="object" string="Restaurar valores predeterminados"
                            invisible="not id" groups="hr_attendance.group_hr_attendance_manager"
                            confirm="Se restaurarán los encabezados, el orden y las columnas visibles de este formato. ¿Continuar?"/>
                    <button name="action_apply_to_other_format" type="object" string="Aplicar también al otro formato"
                            invisible="not id" groups="hr_attendance.group_hr_attendance_manager"
                            confirm="Se copiarán los encabezados, el orden y las columnas visibles al otro formato de esta empresa. Se reemplazará su configuración guardada. ¿Continuar?"/>
                </header>
                <sheet>
                    <group>
                        <field name="company_id" readonly="id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="output_format" readonly="id"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Marca <strong>Mostrar</strong> para elegir las columnas, edita su encabezado y arrastra el control de orden.
                        Los cambios se guardan para esta empresa y formato y se aplican a los próximos archivos.
                        Debe quedar al menos una columna visible en cada sección.
                    </div>
                    <div class="text-muted mb-3" invisible="id">Las columnas se inicializan al guardar la configuración por primera vez.</div>
                    <notebook invisible="not id">
                        <page string="Resumen" name="summary_columns">
                            <field name="summary_line_ids">
                                <list editable="bottom" create="0" delete="0" default_order="sequence,id">
                                    <field name="sequence" widget="handle"/>
                                    <field name="visible"/>
                                    <field name="column_title" readonly="1"/>
                                    <field name="label"/>
                                    <field name="description" readonly="1" optional="hide"/>
                                </list>
                            </field>
                            <p class="text-muted mt-2">Una fila por empleado y fecha laboral. Salida y regreso de comida o trabajo muestran el último par correspondiente; todos los movimientos quedan disponibles en Detalle.</p>
                        </page>
                        <page string="Detalle" name="detail_columns">
                            <field name="detail_line_ids">
                                <list editable="bottom" create="0" delete="0" default_order="sequence,id">
                                    <field name="sequence" widget="handle"/>
                                    <field name="visible"/>
                                    <field name="column_title" readonly="1"/>
                                    <field name="label"/>
                                    <field name="description" readonly="1" optional="hide"/>
                                </list>
                            </field>
                            <p class="text-muted mt-2">Una fila por movimiento o incidencia. Las horas de jornada y las horas extra aprobadas aparecen solo en la salida final.</p>
                        </page>
                    </notebook>
                    <p class="text-muted">Las ausencias futuras siguen ocultas. Esta configuración solo cambia las columnas de Excel y PDF; conserva los datos y las reglas del Reporte de asistencia.</p>
                </sheet>
                <footer>
                    <button string="Guardar" special="save" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="report_layout_action" model="ir.actions.act_window">
        <field name="name">Columnas del Reporte de asistencia</field>
        <field name="res_model">coir.attendance.report.layout</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Personaliza las columnas por empresa y formato.</p>
            <p>También puedes abrir esta configuración desde Reporte Excel / PDF, con el botón Personalizar columnas.</p>
        </field>
    </record>
    <menuitem id="report_layout_menu" name="Columnas del Reporte de asistencia"
              parent="hr_attendance.menu_hr_attendance_configuration" action="report_layout_action"
              sequence="27" groups="hr_attendance.group_hr_attendance_manager"/>
</odoo>
